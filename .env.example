# ---------------------------------------------------------------------------
# Wechatscan — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (required for any DB-backed feature) --------------------------
# PostgreSQL connection string (Neon / Supabase / local). For Vercel and other
# serverless runtimes, use the provider's pooled/serverless connection URL.
DATABASE_URL="postgresql://user:password@host:5432/surjora"

# --- Auth (NextAuth v4) -----------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# Full URL of the site, e.g. https://wechatscan.online (http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"

# --- Admin operator (single admin, credentials provider) --------------------
ADMIN_EMAIL="admin@wechatscan.online"
ADMIN_PASSWORD="change-me-strong-password"

# --- Public site ------------------------------------------------------------
# Used for canonical URLs and OG tags. Public (NEXT_PUBLIC_ is safe to expose).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Direct contact links shown across the site. Leave blank to hide the buttons.
NEXT_PUBLIC_TELEGRAM_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""

# --- Contact form (Resend) --------------------------------------------------
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Wechatscan <contact@wechatscan.online>"
CONTACT_TO_EMAIL="contact@wechatscan.online"

# --- Media (Cloudinary) -----------------------------------------------------
# Leave blank to disable direct file uploads. Admins can still add hosted images
# through the Media library's external-URL option.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- ISR revalidation -------------------------------------------------------
# Shared secret so only our own admin can trigger revalidate.
REVALIDATE_SECRET="change-me"

# --- Spam protection (Cloudflare Turnstile, optional) -----------------------
# Both keys are REQUIRED together. Setting only one fails closed (submissions
# are rejected) to avoid silently disabling protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Rate limiting (Upstash Redis, optional) --------------------------------
# In-memory sliding-window limiter is used when these are blank (resets on each
# serverless cold start / instance). Set both for a durable, multi-instance
# limiter shared across deployments.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Order notifications (Telegram / WhatsApp webhooks, optional) -----------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
WHATSAPP_NUMBER=""
# WhatsApp Business Cloud API (only when using direct WhatsApp notifications)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# --- Analytics (Plausible, optional) ----------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="wechatscan.online"
